---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { onImgError } from "../../utils/images.js";

import { withBase } from "../../utils/blog.js";

const trail = [
  { label: "Home", href: withBase("/") },
  { label: "Contact" },
];
---

<SiteLayout title="Contact">
  <section class="page-hero">
    <div class="page-hero-media" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1600&q=80"
        alt=""
        onerror={onImgError}
      />
      <div class="page-hero-scrim"></div>
    </div>
    <div class="page-hero-content">
      <Breadcrumbs trail={trail} />
      <p class="kicker">Get in Touch</p>
      <h1>Contact</h1>
      <p>Questions, story ideas, and thoughtful notes are always welcome.</p>
    </div>
  </section>

  <main>
    <section class="section" style="max-width: 780px;">
      <p class="intro-copy">
        The Season &amp; Style Guide is built around useful ideas and real conversations.
        Tell us what you are planning, what you would like to see next, or how we can
        make the site more helpful.
      </p>
      <h2 style="margin-bottom: 0.8rem;">Write to our editorial team</h2>
      <p class="intro-copy">
        For editorial questions, corrections, partnership inquiries, or general feedback,
        email <a class="text-link" href="mailto:hello@seasonandstyleguide.com">hello@seasonandstyleguide.com</a>.
        We review every message and respond as soon as we can.
      </p>
    </section>
  </main>
</SiteLayout>
