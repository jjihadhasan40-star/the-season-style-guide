---
// src/pages/blog/index.astro
// Editorial grid of every published article, newest first.
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { categoryHref, collectCategories, sortByDateDesc } from "../../utils/blog.js";

const posts = sortByDateDesc(await getCollection("blog"));
const categories = collectCategories(posts);
---

<SiteLayout
  title="Blog"
  description="Fresh ideas for holidays, seasons, special days, and everyday lifestyle — from The Season & Style Guide."
  active="home"
>
  <section class="page-hero">
    <div class="page-hero-media" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1476820865390-c52aeebb9891?auto=format&fit=crop&w=1600&q=80"
        alt=""
      />
      <div class="page-hero-scrim"></div>
    </div>
    <div class="page-hero-content">
      <p class="kicker">The Journal</p>
      <h1>Blog</h1>
      <p>Editorial ideas and inspiration from The Season &amp; Style Guide.</p>
    </div>
  </section>

  <main>
    <section class="section">
      {categories.length > 0 && (
        <nav class="category-filter" aria-label="Filter by category">
          {categories.map((cat) => (
            <a href={categoryHref(cat.name)}>{cat.name}</a>
          ))}
        </nav>
      )}

      {posts.length > 0 ? (
        <div class="article-grid">
          {posts.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
      ) : (
        <p class="intro-copy">New articles are on the way — check back soon.</p>
      )}
    </section>
  </main>
</SiteLayout>
