---
// src/pages/index.astro
// The Season & Style Guide — Homepage
// Astro + plain HTML/CSS only. No frameworks, no extra dependencies.
import heroImage from "./blog/hero-halloween.jpg";
import Header from "../components/Header.astro";
import { getCollection } from "astro:content";
import { categoryHref, postHref, sortForLatest } from "../utils/blog.js";

// Pulls the latest articles from the blog content collection automatically —
// publish a new Markdown file and it appears here without touching this page,
// with featured: true posts prioritized ahead of the rest.
const latestPosts = sortForLatest(await getCollection("blog")).slice(0, 3);

// Fallback placeholder used if any remote image fails to load.
const fallbackImg = `data:image/svg+xml,${encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f3ead9"/><stop offset="1" stop-color="#c9a24b"/></linearGradient></defs><rect width="100%" height="100%" fill="url(#g)"/></svg>'
)}`;
const onImgError = `this.onerror=null;this.src='${fallbackImg}'`;

const holidays = [
  {
    name: "Halloween",
    href: "/holidays-seasons/",
    img: "https://images.unsplash.com/photo-1509557965875-b88c97052f0e?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Thanksgiving",
    href: "/holidays-seasons/",
    img: "https://images.unsplash.com/photo-1631310383178-ca2dc06444ee?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Christmas",
    href: "/holidays-seasons/",
    img: "https://images.unsplash.com/photo-1543589077-47d81606c1bf?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Easter",
    href: "/holidays-seasons/",
    img: "https://images.unsplash.com/photo-1522069169874-c58ec4b76be5?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Valentine's Day",
    href: "/holidays-seasons/",
    img: "https://images.unsplash.com/photo-1518199266791-5375a83190b7?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Fall",
    href: "/holidays-seasons/",
    img: "https://images.unsplash.com/photo-1476820865390-c52aeebb9891?auto=format&fit=crop&w=400&q=80",
  },
];

const stories = [
  {
    tag: "Halloween",
    title: "A Spooky Welcome: Front Porch Ideas That Wow",
    img: "https://images.unsplash.com/photo-1509557965875-b88c97052f0e?auto=format&fit=crop&w=700&q=80",
    href: "/holidays-seasons/",
  },
  {
    tag: "Fall",
    title: "Cozy Fall Living Room Ideas",
    img: "https://images.unsplash.com/photo-1493663284031-b7e3aefcae8e?auto=format&fit=crop&w=700&q=80",
    href: "/lifestyle/",
  },
  {
    tag: "Thanksgiving",
    title: "A Modern Thanksgiving Table, From Start to Finish",
    img: "https://images.unsplash.com/photo-1631310383178-ca2dc06444ee?auto=format&fit=crop&w=700&q=80",
    href: "/holidays-seasons/",
  },
  {
    tag: "Christmas",
    title: "The Ultimate Christmas Gift Guide",
    img: "https://images.unsplash.com/photo-1512389142860-9c449e58a543?auto=format&fit=crop&w=700&q=80",
    href: "/holidays-seasons/",
  },
];

const specialDays = [
  {
    name: "Mother's Day",
    href: "/special-days/",
    img: "https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Father's Day",
    href: "/special-days/",
    img: "https://images.unsplash.com/photo-1523049673857-eb18f1d7b578?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Graduation",
    href: "/special-days/",
    img: "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Baby Shower",
    href: "/special-days/",
    img: "https://images.unsplash.com/photo-1522771930-78848d9293e8?auto=format&fit=crop&w=400&q=80",
  },
];

const lifestyle = [
  {
    name: "Home",
    href: "/lifestyle/",
    img: "https://images.unsplash.com/photo-1493663284031-b7e3aefcae8e?auto=format&fit=crop&w=300&q=80",
  },
  {
    name: "Fashion",
    href: "/lifestyle/",
    img: "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=300&q=80",
  },
  {
    name: "Food",
    href: "/lifestyle/",
    img: "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=300&q=80",
  },
  {
    name: "Beauty",
    href: "/lifestyle/",
    img: "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=300&q=80",
  },
];

const picks = [
  {
    name: "Ceramic Pumpkin Candle Set",
    note: "Cozy vibes for your home",
    img: "https://images.unsplash.com/photo-1509557965875-b88c97052f0e?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Linen Table Runner",
    note: "Elevate your holiday table",
    img: "https://images.unsplash.com/photo-1631310383178-ca2dc06444ee?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Copper Moscow Mule Mugs",
    note: "Perfect for festive drinks",
    img: "https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&w=400&q=80",
  },
  {
    name: "Fall Wreath",
    note: "Add warmth to your door",
    img: "https://images.unsplash.com/photo-1668300566192-85e76c99c0b7?auto=format&fit=crop&w=400&q=80",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>The Season & Style Guide — The Art of a Beautifully Spooky Home</title>
    <meta
      name="description"
      content="A premium editorial destination for holidays, seasons, special days, and everyday lifestyle inspiration."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- ===================== HEADER ===================== -->
    <Header active="home" />

    <!-- ===================== HERO ===================== -->
    <section class="hero">
      <div class="hero-media" aria-hidden="true">
        <img
          src={heroImage.src}
          alt=""
          onerror={onImgError}
        />
        <div class="hero-scrim"></div>
      </div>
      <div class="hero-content">
        <p class="eyebrow">Halloween 2026</p>
        <h1>The Art of a Beautifully Spooky Home</h1>
        <p class="hero-copy">
          From hauntingly beautiful decor to creative costumes, festive recipes
          and more — discover fresh ideas to make this Halloween unforgettable.
        </p>
        <a class="btn btn-primary" href="/holidays-seasons/">Explore Halloween</a>
      </div>
      <a class="scroll-hint" href="#holidays">
        <span>Scroll Down</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 4V20M12 20L6 14M12 20L18 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <div class="hero-curve"></div>
    </section>

    <main>
      <!-- ===================== HOLIDAYS & SEASONS ===================== -->
      <section class="section" id="holidays">
        <div class="section-head">
          <div class="section-head-text">
            <p class="kicker">Explore</p>
            <h2>Holidays &amp; Seasons</h2>
          </div>
          <a class="view-all" href="/holidays-seasons/">View All &rarr;</a>
        </div>

        <ul class="category-row">
          {holidays.map((h) => (
            <li>
              <a href={h.href}>
                <span class="category-circle">
                  <img src={h.img} alt={h.name} loading="lazy" onerror={onImgError} />
                </span>
                <span class="category-label">{h.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- ===================== FEATURED STORIES ===================== -->
      <section class="section section-tint">
        <div class="section-head">
          <div class="section-head-text">
            <p class="kicker">Featured Stories</p>
          </div>
          <a class="view-all" href="/holidays-seasons/">View All &rarr;</a>
        </div>

        <ul class="story-grid">
          {stories.map((s) => (
            <li class="story-card">
              <a href={s.href} class="story-media">
                <img src={s.img} alt={s.title} loading="lazy" onerror={onImgError} />
              </a>
              <div class="story-body">
                <p class="story-tag">{s.tag}</p>
                <h3><a href={s.href}>{s.title}</a></h3>
                <a class="story-link" href={s.href}>
                  Read More <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- ===================== LATEST FROM THE BLOG ===================== -->
      {latestPosts.length > 0 && (
        <section class="section">
          <div class="section-head">
            <div class="section-head-text">
              <p class="kicker">The Journal</p>
              <h2>Latest from The Season &amp; Style Guide</h2>
            </div>
            <a class="view-all" href="/blog/">View All &rarr;</a>
          </div>

          <ul class="story-grid">
            {latestPosts.map((post) => (
              <li class="story-card">
                <a href={postHref(post)} class="story-media">
                  <img src={post.data.image} alt={post.data.title} loading="lazy" onerror={onImgError} />
                </a>
                <div class="story-body">
                  <p class="story-tag">
                    <a href={categoryHref(post.data.category)}>{post.data.category}</a>
                  </p>
                  <h3><a href={postHref(post)}>{post.data.title}</a></h3>
                  <a class="story-link" href={postHref(post)}>
                    Read More <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- ===================== SPECIAL DAYS ===================== -->
      <section class="section">
        <div class="section-head section-head-center">
          <p class="kicker">Special Days</p>
        </div>

        <ul class="category-row category-row-center">
          {specialDays.map((d) => (
            <li>
              <a href={d.href}>
                <span class="category-circle category-circle-soft">
                  <img src={d.img} alt={d.name} loading="lazy" onerror={onImgError} />
                </span>
                <span class="category-label">{d.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- ===================== LIFESTYLE BANNER ===================== -->
      <section class="lifestyle-band">
        <div class="lifestyle-inner">
          <div class="lifestyle-text">
            <p class="kicker">Living Well</p>
            <h2>Lifestyle</h2>
            <p class="lifestyle-copy">
              Home, fashion, food, beauty and more — for a more inspired everyday.
            </p>
            <a class="text-link" href="/lifestyle/">Explore Lifestyle &rarr;</a>
          </div>
          <ul class="lifestyle-categories">
            {lifestyle.map((l) => (
              <li>
                <a href={l.href}>
                  <span class="category-circle category-circle-sm">
                    <img src={l.img} alt={l.name} loading="lazy" onerror={onImgError} />
                  </span>
                  <span class="category-label">{l.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ===================== THE EDIT / CURATED PICKS ===================== -->
      <section class="section">
        <div class="section-head">
          <div class="section-head-text">
            <p class="kicker">The Edit</p>
            <h2>Curated Picks</h2>
          </div>
          <a class="view-all" href="/lifestyle/">View All Picks &rarr;</a>
        </div>

        <ul class="picks-grid">
          {picks.map((p) => (
            <li class="pick-card">
              <a href="/lifestyle/" class="pick-media">
                <img src={p.img} alt={p.name} loading="lazy" onerror={onImgError} />
              </a>
              <div class="pick-body">
                <h3>{p.name}</h3>
                <p>{p.note}</p>
                <a class="pick-link" href="/lifestyle/">View Product &rarr;</a>
              </div>
            </li>
          ))}
          <li class="pick-cta">
            <h3>Thoughtful Finds for Every Season</h3>
            <a class="round-btn" href="/lifestyle/" aria-label="View all curated picks">&rarr;</a>
          </li>
        </ul>
      </section>
    </main>

    <!-- ===================== FOOTER ===================== -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="brand brand-light" href="/">
            <img class="brand-logo" src="/logo.png" alt="The Season &amp; Style Guide" />
          </a>
          <p>
            We're here to help you celebrate the seasons, special moments with
            style, creativity and a little extra joy.
          </p>
          <a class="text-link text-link-light" href="/about/">Learn More &rarr;</a>
        </div>

        <nav class="footer-nav" aria-label="Footer">
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/holidays-seasons/">Holidays &amp; Seasons</a></li>
            <li><a href="/special-days/">Special Days</a></li>
            <li><a href="/lifestyle/">Lifestyle</a></li>
          </ul>
        </nav>

        <nav class="footer-nav" aria-label="Legal">
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/about/">Contact</a></li>
            <li><a href="/about/">Privacy Policy</a></li>
            <li><a href="/about/">Affiliate Disclosure</a></li>
          </ul>
        </nav>
      </div>
      <p class="footer-bottom">&copy; 2026 The Season &amp; Style Guide. All rights reserved.</p>
    </footer>

    <style>
      /* ============ TOKENS ============ */
      :root {
        --ivory: #faf6ee;
        --ivory-deep: #f3ead9;
        --ink: #2a2320;
        --ink-soft: #5a4f47;
        --burnt-orange: #c1622d;
        --burnt-orange-deep: #a24d20;
        --brown: #5c4632;
        --gold: #c9a24b;
        --cream-card: #ffffff;
        --border-soft: rgba(42, 35, 32, 0.1);
        --shadow-soft: 0 20px 40px -24px rgba(42, 23, 8, 0.35);
        --radius-lg: 28px;
        --radius-md: 18px;
        --font-serif: "Playfair Display", "Times New Roman", serif;
        --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --container: 1240px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--ink);
        background: var(--ivory);
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      h1, h2, h3 {
        font-family: var(--font-serif);
        font-weight: 600;
        margin: 0;
        color: var(--ink);
      }

      :focus-visible {
        outline: 2px solid var(--burnt-orange);
        outline-offset: 3px;
      }

      .kicker {
        font-family: var(--font-sans);
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        color: var(--burnt-orange-deep);
        margin: 0 0 0.4rem;
        font-weight: 600;
      }

      /* ============ HEADER ============ */
      .site-header {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 20;
        padding: 1.6rem 0 0;
        animation: header-rise 0.8s ease-out both;
      }

      .header-inner {
        max-width: var(--container);
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        color: #fff;
        font-family: var(--font-serif);
        font-size: 1.08rem;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }

      .brand-mark {
        flex-shrink: 0;
      }

      .brand-logo {
        width: 190px;
        height: auto;
        display: block;
        filter: brightness(0) invert(1);
      }

      .main-nav ul {
        display: flex;
        gap: 2.2rem;
      }

      .main-nav a {
        color: rgba(255, 255, 255, 0.88);
        font-size: 0.92rem;
        font-weight: 500;
        padding-bottom: 0.35rem;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease, color 0.2s ease;
      }

      .main-nav a:hover,
      .main-nav a.active {
        color: #fff;
        border-color: rgba(255, 255, 255, 0.85);
      }

      .icon-btn {
        background: none;
        border: none;
        color: #fff;
        cursor: pointer;
        padding: 0.3rem;
        display: flex;
      }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        min-height: 620px;
        display: flex;
        align-items: center;
        overflow: hidden;
        background: #1c1410;
      }

      .hero-media {
        position: absolute;
        inset: 0;
      }

      .hero-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero-scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          115deg,
          rgba(20, 12, 8, 0.94) 0%,
          rgba(40, 20, 10, 0.76) 38%,
          rgba(60, 30, 12, 0.28) 62%,
          rgba(60, 30, 12, 0.1) 100%
        );
      }

      .hero-content {
        position: relative;
        z-index: 2;
        max-width: var(--container);
        margin: 0 auto;
        width: 100%;
        padding: 8rem 2rem 6rem;
        animation: header-rise 0.9s 0.1s ease-out both;
      }

      @keyframes header-rise {
        from {
          opacity: 0;
          transform: translateY(2rem);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .site-header,
        .hero-content {
          animation: none;
        }
      }

      .eyebrow {
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        font-weight: 600;
        margin: 0 0 1.1rem;
        position: relative;
        padding-left: 1.6rem;
      }

      .eyebrow::before {
        content: "";
        position: absolute;
        left: 0;
        top: 50%;
        width: 1.1rem;
        height: 1px;
        background: rgba(255, 255, 255, 0.6);
        transform: translateY(-50%);
      }

      .hero-content h1 {
        color: #fff;
        font-size: clamp(2.4rem, 4.6vw, 3.6rem);
        line-height: 1.12;
        max-width: 14ch;
        margin-bottom: 1.4rem;
      }

      .hero-copy {
        color: rgba(255, 255, 255, 0.82);
        font-size: 1.02rem;
        line-height: 1.65;
        max-width: 34ch;
        margin: 0 0 2rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.95rem 1.9rem;
        border-radius: 999px;
        font-size: 0.95rem;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn-primary {
        background: var(--ivory);
        color: var(--brown);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 28px -12px rgba(0, 0, 0, 0.45);
      }

      .scroll-hint {
        position: absolute;
        right: 3rem;
        bottom: 3.2rem;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        width: 92px;
        height: 92px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.4);
        color: #fff;
        justify-content: center;
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        text-align: center;
        line-height: 1.2;
      }

      .hero-curve {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 90px;
        background: var(--ivory);
        border-radius: 60% 60% 0 0 / 100% 100% 0 0;
        z-index: 1;
      }

      /* ============ SECTION SHELL ============ */
      .section {
        max-width: var(--container);
        margin: 0 auto;
        padding: 4.5rem 2rem;
      }

      .section-tint {
        max-width: none;
        background: var(--ivory-deep);
        padding-left: 0;
        padding-right: 0;
      }

      .section-tint > * {
        max-width: var(--container);
        margin-left: auto;
        margin-right: auto;
        padding-left: 2rem;
        padding-right: 2rem;
      }

      .section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 2.6rem;
        gap: 1rem;
      }

      .section-head-center {
        justify-content: center;
        text-align: center;
      }

      .section-head-text h2 {
        font-size: clamp(1.7rem, 2.6vw, 2.3rem);
      }

      .view-all {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--burnt-orange-deep);
        white-space: nowrap;
      }

      /* ============ CATEGORY ROW ============ */
      .category-row {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 1.6rem;
      }

      .category-row-center {
        grid-template-columns: repeat(4, 1fr);
        max-width: 780px;
        margin: 0 auto;
      }

      .category-row li a {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.9rem;
        text-align: center;
      }

      .category-circle {
        width: 118px;
        height: 118px;
        border-radius: 50%;
        overflow: hidden;
        box-shadow: var(--shadow-soft);
        border: 3px solid var(--cream-card);
        transition: transform 0.25s ease;
        background: var(--ivory-deep);
      }

      .category-circle-soft {
        box-shadow: 0 16px 32px -20px rgba(60, 30, 12, 0.28);
      }

      .category-circle-sm {
        width: 76px;
        height: 76px;
        border-width: 2px;
      }

      .category-row li a:hover .category-circle {
        transform: translateY(-4px);
      }

      .category-circle img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .category-label {
        font-size: 0.92rem;
        font-weight: 500;
        color: var(--ink);
      }

      /* ============ FEATURED STORIES ============ */
      .story-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.6rem;
      }

      .story-card {
        background: var(--cream-card);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: 0 18px 36px -26px rgba(42, 23, 8, 0.3);
        display: flex;
        flex-direction: column;
      }

      .story-media {
        display: block;
        aspect-ratio: 4 / 3.1;
        overflow: hidden;
        background: var(--ivory-deep);
      }

      .story-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
      }

      .story-card:hover .story-media img {
        transform: scale(1.05);
      }

      .story-body {
        padding: 1.4rem 1.5rem 1.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        flex: 1;
      }

      .story-tag {
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        color: var(--ink-soft);
        margin: 0;
        text-transform: uppercase;
      }

      .story-body h3 {
        font-size: 1.15rem;
        line-height: 1.35;
        font-weight: 600;
      }

      .story-link {
        margin-top: auto;
        padding-top: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--burnt-orange-deep);
      }

      /* ============ LIFESTYLE BAND ============ */
      .lifestyle-band {
        background: linear-gradient(120deg, var(--ivory-deep), #ece3d4 60%, #e7dccb);
        padding: 3.4rem 2rem;
      }

      .lifestyle-inner {
        max-width: var(--container);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 3rem;
        flex-wrap: wrap;
      }

      .lifestyle-text {
        max-width: 340px;
      }

      .lifestyle-text h2 {
        font-size: 2rem;
        margin-bottom: 0.7rem;
      }

      .lifestyle-copy {
        color: var(--ink-soft);
        line-height: 1.6;
        margin: 0 0 1rem;
      }

      .text-link {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--burnt-orange-deep);
      }

      .text-link-light {
        color: #fff;
      }

      .lifestyle-categories {
        display: flex;
        gap: 2.4rem;
      }

      .lifestyle-categories li a {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
      }

      /* ============ CURATED PICKS ============ */
      .picks-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1.4rem;
      }

      .pick-card {
        background: var(--cream-card);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: 0 14px 30px -24px rgba(42, 23, 8, 0.32);
      }

      .pick-media {
        display: block;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: var(--ivory-deep);
      }

      .pick-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .pick-body {
        padding: 1.1rem 1.2rem 1.3rem;
      }

      .pick-body h3 {
        font-size: 0.96rem;
        font-weight: 600;
        margin-bottom: 0.3rem;
        line-height: 1.3;
      }

      .pick-body p {
        font-size: 0.82rem;
        color: var(--ink-soft);
        margin: 0 0 0.7rem;
      }

      .pick-link {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--burnt-orange-deep);
      }

      .pick-cta {
        background: var(--ivory-deep);
        border-radius: var(--radius-md);
        padding: 1.6rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 100%;
      }

      .pick-cta h3 {
        font-size: 1.1rem;
        line-height: 1.35;
        font-weight: 600;
        margin-bottom: 1.2rem;
      }

      .round-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--burnt-orange);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
      }

      /* ============ FOOTER ============ */
      .site-footer {
        background: linear-gradient(150deg, #2c2440 0%, #4a3a4f 45%, #a6785a 100%);
        color: rgba(255, 255, 255, 0.85);
        padding: 4rem 2rem 1.6rem;
      }

      .footer-inner {
        max-width: var(--container);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr;
        gap: 2.5rem;
        padding-bottom: 2.6rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      }

      .brand-light {
        margin-bottom: 1rem;
      }

      .footer-brand p {
        font-size: 0.9rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.72);
        max-width: 34ch;
        margin: 0 0 1rem;
      }

      .footer-nav ul {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .footer-nav a {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.78);
      }

      .footer-nav a:hover {
        color: #fff;
      }

      .footer-bottom {
        max-width: var(--container);
        margin: 1.6rem auto 0;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.6);
      }

      /* ============ RESPONSIVE ============ */
      @media (max-width: 1080px) {
        .story-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .picks-grid {
          grid-template-columns: repeat(3, 1fr);
        }
        .picks-grid .pick-cta {
          grid-column: span 3;
        }
        .category-row {
          grid-template-columns: repeat(3, 1fr);
          row-gap: 2.2rem;
        }
      }

      @media (max-width: 860px) {
        .main-nav {
          display: none;
        }
        .header-inner {
          justify-content: space-between;
        }
        .hero {
          min-height: 560px;
        }
        .hero-content {
          padding: 7rem 1.6rem 5rem;
        }
        .scroll-hint {
          display: none;
        }
        .footer-inner {
          grid-template-columns: 1fr 1fr;
        }
        .footer-brand {
          grid-column: span 2;
        }
        .lifestyle-inner {
          justify-content: center;
          text-align: center;
        }
        .lifestyle-text {
          max-width: 100%;
        }
        .lifestyle-categories {
          justify-content: center;
          flex-wrap: wrap;
        }
      }

      @media (max-width: 640px) {
        .section {
          padding: 3.2rem 1.4rem;
        }
        .section-tint > * {
          padding-left: 1.4rem;
          padding-right: 1.4rem;
        }
        .category-row,
        .category-row-center {
          grid-template-columns: repeat(2, 1fr);
        }
        .category-circle {
          width: 96px;
          height: 96px;
        }
        .story-grid {
          grid-template-columns: 1fr;
        }
        .picks-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .picks-grid .pick-cta {
          grid-column: span 2;
        }
        .section-head {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.6rem;
        }
        .footer-inner {
          grid-template-columns: 1fr;
        }
        .footer-brand {
          grid-column: span 1;
        }
        .lifestyle-categories {
          gap: 1.4rem;
        }
      }
    </style>
  </body>
</html>