---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import MainCategoryLanding from "../../components/MainCategoryLanding.astro";
import { specialDayCategories } from "../../data/categoryStructure.js";
import { postsInCategory, sortByDateDesc } from "../../utils/blog.js";

export function getStaticPaths() {
  return specialDayCategories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = sortByDateDesc(postsInCategory(await getCollection("blog"), category.name));
---
<SiteLayout title={category.name} description={category.tagline} active="special">
  <MainCategoryLanding
    category={category}
    sectionLabel="Special Days"
    sectionHref={import.meta.env.BASE_URL + "special-days/"}
    basePath={import.meta.env.BASE_URL + "special-days/"}
    posts={posts}
  />
</SiteLayout>