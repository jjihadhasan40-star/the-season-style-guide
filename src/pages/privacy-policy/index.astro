---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { onImgError } from "../../utils/images.js";

import { withBase } from "../../utils/blog.js";

const trail = [
  { label: "Home", href: withBase("/") },
  { label: "Privacy Policy" },
];
---

<SiteLayout title="Privacy Policy">
  <section class="page-hero">
    <div class="page-hero-media" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1456324504439-367cee3b3c32?auto=format&fit=crop&w=1600&q=80"
        alt=""
        onerror={onImgError}
      />
      <div class="page-hero-scrim"></div>
    </div>
    <div class="page-hero-content">
      <Breadcrumbs trail={trail} />
      <p class="kicker">Your Privacy</p>
      <h1>Privacy Policy</h1>
      <p>How we approach information, cookies, and a respectful reading experience.</p>
    </div>
  </section>

  <main>
    <section class="section" style="max-width: 820px;">
      <p class="intro-copy">
        We aim to keep this site useful, transparent, and considerate of your privacy.
        This policy describes the general information we may receive when you browse
        The Season &amp; Style Guide and how it is used to maintain the publication.
      </p>
      <h2 style="margin-bottom: 0.8rem;">Information we use</h2>
      <p class="intro-copy">
        We may receive basic technical information, such as browser type, device type,
        and pages visited, through hosting and analytics services. This helps us understand
        which editorial resources are useful and improve site performance. We do not sell
        personal information.
      </p>
      <h2 style="margin-bottom: 0.8rem;">Cookies and third-party links</h2>
      <p class="intro-copy">
        The site may use necessary cookies or privacy-conscious analytics tools. Articles
        may also link to other websites with their own policies. Please review those policies
        before sharing information with an external service. Questions about this policy can
        be sent through our <a class="text-link" href={withBase("/contact/")}>Contact page</a>.
      </p>
    </section>
  </main>
</SiteLayout>
