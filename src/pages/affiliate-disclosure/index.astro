---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { onImgError } from "../../utils/images.js";

import { withBase } from "../../utils/blog.js";

const trail = [
  { label: "Home", href: withBase("/") },
  { label: "Affiliate Disclosure" },
];
---

<SiteLayout title="Affiliate Disclosure">
  <section class="page-hero">
    <div class="page-hero-media" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1600&q=80"
        alt=""
        onerror={onImgError}
      />
      <div class="page-hero-scrim"></div>
    </div>
    <div class="page-hero-content">
      <Breadcrumbs trail={trail} />
      <p class="kicker">Our Commitment</p>
      <h1>Affiliate Disclosure</h1>
      <p>How partnerships support the work while keeping recommendations thoughtful.</p>
    </div>
  </section>

  <main>
    <section class="section" style="max-width: 820px;">
      <p class="intro-copy">
        Some links on The Season &amp; Style Guide may be affiliate links. If you choose
        to purchase through one of those links, we may earn a commission at no additional
        cost to you. These commissions help support the time and care behind our editorial work.
      </p>
      <h2 style="margin-bottom: 0.8rem;">Our editorial standard</h2>
      <p class="intro-copy">
        Compensation does not determine what we cover or how we describe it. We only share
        products, services, and ideas that we believe are relevant to the story and useful
        to our readers. Recommendations reflect our editorial judgment and are clearly identified
        when a commercial relationship applies.
      </p>
      <p class="intro-copy">
        For questions about a recommendation or a partnership, please visit our
        <a class="text-link" href={withBase("/contact/")}>Contact page</a>.
      </p>
    </section>
  </main>
</SiteLayout>
