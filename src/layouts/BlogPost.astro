---
// src/layouts/BlogPost.astro
// Premium editorial article template. Every Markdown/MDX file in
// src/content/blog/ renders through this automatically — no per-article code.
import { getCollection, type CollectionEntry } from "astro:content";
import SiteLayout from "./SiteLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { onImgError } from "../utils/images.js";
import { categoryHref, getRelatedPosts, postHref, sortByDateAsc, subcategoryHref, withBase } from "../utils/blog.js";

export interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { title, description, date, category, subcategory, image, author, tags } = post.data;
const categoryLink = subcategory ? subcategoryHref(category, subcategory) : categoryHref(category);

const allPosts = await getCollection("blog");
const related = getRelatedPosts(post, allPosts, 3);

// Previous/next by chronological (oldest-first) order, so the pair is stable
// as new articles are published rather than shifting around.
const chronological = sortByDateAsc(allPosts);
const currentIndex = chronological.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? chronological[currentIndex - 1] : undefined;
const nextPost =
  currentIndex >= 0 && currentIndex < chronological.length - 1
    ? chronological[currentIndex + 1]
    : undefined;

const trail = [
  { label: "Home", href: withBase("/") },
  { label: "Blog", href: withBase("/blog/") },
  { label: subcategory ?? category, href: categoryLink },
  { label: title },
];
---

<SiteLayout title={title} description={description} image={image} type="article" publishedTime={date}>
  <article>
    <header class="article-header">
      <div class="article-header-inner">
        <Breadcrumbs trail={trail} />
        <a class="kicker article-category" href={categoryLink}>{subcategory ?? category}</a>
        <h1>{title}</h1>
        <p class="article-dek">{description}</p>
        <p class="article-meta">
          {author && <span class="article-author">{author}</span>}
          {author && <span class="article-meta-sep" aria-hidden="true">&middot;</span>}
          <FormattedDate date={date} />
        </p>
      </div>
    </header>

    <div class="article-hero-media">
      <img src={image} alt={title} onerror={onImgError} />
    </div>

    <div class="article-body">
      <slot />
    </div>

    {tags && tags.length > 0 && (
      <div class="article-tags">
        {tags.map((tag) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>
    )}

    {(prevPost || nextPost) && (
      <nav class="article-pagination" aria-label="More articles">
        {prevPost ? (
          <a class="pagination-link pagination-prev" href={postHref(prevPost)}>
            <span class="pagination-label">&larr; Previous</span>
            <span class="pagination-title">{prevPost.data.title}</span>
          </a>
        ) : <span />}
        {nextPost ? (
          <a class="pagination-link pagination-next" href={postHref(nextPost)}>
            <span class="pagination-label">Next &rarr;</span>
            <span class="pagination-title">{nextPost.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}

    {related.length > 0 && (
      <section class="section related-section">
        <div class="section-head">
          <div class="section-head-text">
            <p class="kicker">Keep Reading</p>
            <h2>Related Articles</h2>
          </div>
          <a class="view-all" href={withBase("/blog/")}>View All &rarr;</a>
        </div>
        <div class="article-grid">
          {related.map((r) => (
            <ArticleCard post={r} />
          ))}
        </div>
      </section>
    )}
  </article>
</SiteLayout>

<style is:global>
  /* ============ ARTICLE HEADER ============ */
  .article-header {
    max-width: var(--container);
    margin: 0 auto;
    padding: 9rem 2rem 2.5rem;
  }
  .article-header-inner {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }
  .article-header-inner :global(.breadcrumbs ol) { justify-content: center; }
  .article-category { display: inline-block; }
  .article-header-inner h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    line-height: 1.15;
    margin: 0.6rem 0 1.1rem;
  }
  .article-dek {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 1.4rem;
  }
  .article-meta {
    font-size: 0.88rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .article-author { font-weight: 600; color: var(--ink); }
  .article-meta-sep { margin: 0 0.5rem; opacity: 0.6; }

  /* ============ HERO IMAGE ============ */
  .article-hero-media {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .article-hero-media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }

  /* ============ ARTICLE BODY / MARKDOWN TYPOGRAPHY ============ */
  .article-body {
    max-width: 720px;
    margin: 0 auto;
    padding: 3.2rem 2rem 1rem;
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--ink);
  }
  .article-body h1,
  .article-body h2,
  .article-body h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }
  .article-body h2 { font-size: 1.7rem; margin: 2.6rem 0 1.1rem; }
  .article-body h3 { font-size: 1.3rem; margin: 2.2rem 0 0.9rem; }
  .article-body p { margin: 0 0 1.5rem; }
  .article-body a { color: var(--burnt-orange-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .article-body a:hover { color: var(--burnt-orange); }
  .article-body ul,
  .article-body ol {
    margin: 0 0 1.5rem;
    padding-left: 1.4rem;
  }
  .article-body li { margin-bottom: 0.5rem; }
  .article-body ul { list-style: disc; }
  .article-body ol { list-style: decimal; }
  .article-body blockquote {
    margin: 2rem 0;
    padding: 0.2rem 0 0.2rem 1.4rem;
    border-left: 3px solid var(--burnt-orange);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 1.15rem;
  }
  .article-body img {
    width: 100%;
    border-radius: var(--radius-md);
    margin: 0.6rem 0;
    display: block;
  }
  /* Write an italic line right after an image to have it render as a caption. */
  .article-body img + em {
    display: block;
    text-align: center;
    font-size: 0.86rem;
    color: var(--ink-soft);
    margin: -0.3rem 0 1.5rem;
  }
  .article-body figure { margin: 0 0 1.5rem; }
  .article-body figcaption {
    text-align: center;
    font-size: 0.86rem;
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }
  .article-body strong { font-weight: 700; }
  .article-body em { font-style: italic; }
  .article-body hr {
    border: none;
    border-top: 1px solid rgba(42, 35, 32, 0.14);
    margin: 2.8rem 0;
  }
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.5rem;
    font-size: 0.96rem;
  }
  .article-body th,
  .article-body td {
    border: 1px solid rgba(42, 35, 32, 0.14);
    padding: 0.6rem 0.8rem;
    text-align: left;
  }
  .article-body th { background: var(--ivory-deep); font-weight: 600; }
  .article-body code {
    background: var(--ivory-deep);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.92em;
  }
  .article-body pre {
    background: var(--ivory-deep);
    padding: 1.2rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 0 0 1.5rem;
  }
  .article-body pre code { background: none; padding: 0; }

  /* ============ TAGS ============ */
  .article-tags {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 2rem 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tag-pill {
    display: inline-flex;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--ivory-deep);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  /* ============ PREV/NEXT PAGINATION ============ */
  .article-pagination {
    max-width: 900px;
    margin: 1.5rem auto 0;
    padding: 2rem 2rem 0;
    border-top: 1px solid rgba(42, 35, 32, 0.12);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .pagination-link {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius-md);
    background: var(--cream-card);
    box-shadow: 0 14px 30px -24px rgba(42, 23, 8, 0.32);
    transition: transform 0.2s ease;
  }
  .pagination-link:hover { transform: translateY(-2px); }
  .pagination-next { text-align: right; align-items: flex-end; }
  .pagination-label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--burnt-orange-deep);
  }
  .pagination-title { font-size: 0.98rem; font-weight: 600; line-height: 1.4; }

  /* ============ RELATED ARTICLES ============ */
  .related-section { padding-top: 3.5rem; }

  @media (max-width: 640px) {
    .article-header { padding: 7.5rem 1.4rem 2rem; }
    .article-hero-media { padding: 0 1.4rem; }
    .article-body { padding: 2.4rem 1.4rem 1rem; }
    .article-tags { padding: 0 1.4rem 1rem; }
    .article-pagination { grid-template-columns: 1fr; padding: 2rem 1.4rem 0; }
    .pagination-next { text-align: left; align-items: flex-start; }
  }
</style>
