---
import Breadcrumbs from "./Breadcrumbs.astro";
import ArticleCard from "./ArticleCard.astro";
import { onImgError } from "../utils/images.js";
import { withBase } from "../utils/blog.js";

export interface Props {
  category: {
    slug: string;
    name: string;
    tagline: string;
    intro: string;
    heroImg: string;
    subcategories: { slug: string; name: string; tagline: string; heroImg: string }[];
  };
  sectionLabel: string;
  sectionHref: string;
  basePath: string;
  posts?: {
    id: string;
    data: {
      title: string;
      description: string;
      date: Date;
      category: string;
      subcategory?: string;
      image: string;
    };
  }[];
}

const { category, sectionLabel, sectionHref, basePath, posts = [] } = Astro.props;
const trail = [
  { label: "Home", href: withBase("/") },
  { label: sectionLabel, href: sectionHref },
  { label: category.name },
];
---

<section class="page-hero">
  <div class="page-hero-media" aria-hidden="true">
    <img src={category.heroImg} alt="" onerror={onImgError} />
    <div class="page-hero-scrim"></div>
  </div>
  <div class="page-hero-content">
    <Breadcrumbs trail={trail} />
    <p class="kicker">{sectionLabel}</p>
    <h1>{category.name}</h1>
    <p>{category.tagline}</p>
  </div>
</section>

<main>
  <section class="section">
    <p class="intro-copy">{category.intro}</p>
    <div class="section-head">
      <div><h2>Latest articles</h2></div>
    </div>
    {posts.length > 0 ? (
      <div class="article-grid">
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    ) : (
      <p class="archive-empty">New {category.name} articles are on the way — check back soon.</p>
    )}
  </section>
</main>

<style>
  .archive-empty {
    color: var(--ink-soft);
    line-height: 1.7;
  }
</style>
