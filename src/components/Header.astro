---
// src/components/Header.astro
export interface Props {
  active?: "home" | "holidays" | "special" | "lifestyle" | "about";
}
const { active = "" } = Astro.props;

const nav = [
  { key: "home", label: "Home", href: "/" },
  {
    key: "holidays",
    label: "Holidays & Seasons",
    href: "/holidays/",
  },
  {
    key: "special",
    label: "Special Days",
    href: "/special-days/",
  },
  {
    key: "lifestyle",
    label: "Lifestyle",
    href: "/lifestyle/",
  },
  { key: "about", label: "About", href: "/about/" },
];
---

<header class="site-header">
  <div class="header-inner">
    <button class="mobile-menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <a class="brand" href="/">
      <img class="brand-logo" src="/logo.png" alt="The Season &amp; Style Guide" />
    </a>
    <nav class="main-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <div class="nav-group">
              <a href={item.href} class={item.key === active ? "active" : ""}>{item.label}</a>
            </div>
          </li>
        ))}
      </ul>
    </nav>
    <div class="search-wrap">
      <button class="icon-btn" type="button" aria-label="Search" aria-expanded="false" aria-controls="site-search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6"/>
          <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
      <form id="site-search" class="search-form" action="/search/" method="get" hidden>
        <label class="sr-only" for="site-search-input">Search articles</label>
        <input id="site-search-input" name="q" type="search" placeholder="Search articles" autocomplete="off" />
        <button type="submit">Search</button>
      </form>
    </div>
  </div>
  <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile primary" hidden>
    <ul>
      {nav.map((item) => (
        <li><a href={item.href} class={item.key === active ? "active" : ""}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const searchWrap = document.querySelector('.search-wrap');
  const searchButton = searchWrap?.querySelector('.icon-btn');
  const searchForm = searchWrap?.querySelector('.search-form');
  const searchInput = searchForm?.querySelector('input');
  const mobileMenuButton = document.querySelector('.mobile-menu-toggle');
  const mobileMenu = document.querySelector('.mobile-nav');

  mobileMenuButton?.addEventListener('click', () => {
    if (!mobileMenu) return;
    const isOpen = !mobileMenu.hidden;
    mobileMenu.hidden = isOpen;
    mobileMenuButton.setAttribute('aria-expanded', String(!isOpen));
    mobileMenuButton.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
  });

  searchButton?.addEventListener('click', () => {
    if (!searchForm || !searchButton) return;
    const isOpen = !searchForm.hidden;
    searchForm.hidden = isOpen;
    searchButton.setAttribute('aria-expanded', String(!isOpen));
    if (!isOpen) searchInput?.focus();
  });

  document.addEventListener('click', (event) => {
    if (!searchWrap?.contains(event.target as Node)) {
      searchForm?.setAttribute('hidden', '');
      searchButton?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && searchForm && !searchForm.hidden) {
      searchForm.setAttribute('hidden', '');
      searchButton?.setAttribute('aria-expanded', 'false');
      searchButton?.focus();
    }
    if (event.key === 'Escape' && mobileMenu && !mobileMenu.hidden) {
      mobileMenu.hidden = true;
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
      mobileMenuButton?.setAttribute('aria-label', 'Open navigation menu');
      mobileMenuButton?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    background: #000;
    padding: 1.6rem 0 0;
  }
  .header-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: #fff;
    font-family: var(--font-serif);
    font-size: 1.08rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .brand-logo { width: 190px; height: auto; display: block; filter: brightness(0) invert(1); }
  .mobile-menu-toggle, .mobile-nav { display: none; }
  .main-nav > ul { display: flex; gap: 2.2rem; }
  .nav-group { padding-bottom: 0.35rem; }
  .main-nav a {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.92rem;
    font-weight: 500;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .main-nav a:hover, .main-nav a.active {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.85);
  }
  .icon-btn {
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 0.3rem;
    display: flex;
  }
  .search-wrap { position: relative; }
  .search-form {
    position: absolute;
    top: calc(100% + 0.7rem);
    right: 0;
    display: flex;
    z-index: 30;
    gap: 0.45rem;
    padding: 0.45rem;
    background: rgba(42, 35, 32, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
  }
  .search-form[hidden] { display: none; }
  .search-form input {
    width: 12rem;
    min-width: 0;
    border: 0;
    padding: 0.55rem 0.65rem;
    color: var(--ink);
    background: var(--ivory);
    font: inherit;
  }
  .search-form button {
    border: 0;
    padding: 0.55rem 0.7rem;
    color: #fff;
    background: var(--burnt-orange);
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 860px) {
    .header-inner {
      position: relative;
      flex-wrap: nowrap;
      min-height: 2.75rem;
      padding-left: 1rem;
      padding-right: 1rem;
      gap: 0;
    }
    .mobile-menu-toggle {
      width: 2.75rem;
      height: 2.75rem;
      padding: 0.65rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.3rem;
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 6px;
      background: transparent;
      color: #fff;
      cursor: pointer;
    }
    .mobile-menu-toggle span {
      display: block;
      width: 100%;
      height: 2px;
      border-radius: 999px;
      background: currentColor;
    }
    .main-nav { display: none; }
    .brand {
      position: static;
      width: 0;
      height: 0;
    }
    .brand-logo {
      position: absolute;
      top: 50%;
      left: 50vw;
      width: min(190px, calc(100vw - 9rem));
      transform: translate(-50%, -50%);
    }
    .search-wrap {
      margin-left: auto;
      z-index: 1;
    }
    .search-wrap .icon-btn {
      width: 2.75rem;
      height: 2.75rem;
      align-items: center;
      justify-content: center;
    }
    .mobile-nav {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 1rem 2rem 1.25rem;
      background: var(--ivory);
      border-radius: 0 0 12px 12px;
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.22);
    }
    .mobile-nav[hidden] { display: none; }
    .mobile-nav ul { display: grid; gap: 0.2rem; }
    .mobile-nav a {
      display: block;
      padding: 0.8rem 0.75rem;
      color: var(--ink);
      font-family: var(--font-serif);
      font-size: 1.05rem;
      border-radius: 6px;
    }
    .mobile-nav a:hover, .mobile-nav a.active { background: var(--ivory-deep); }
    .search-form {
      right: -0.25rem;
      max-width: calc(100vw - 2.8rem);
    }
    .search-form input { width: min(12rem, 52vw); }
  }
</style>